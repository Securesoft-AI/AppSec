# --- GitHub App (ver docs/DESPLIEGUE.md) ---
GITHUB_APP_ID=
# Clave privada PEM en una línea, con \n en lugar de saltos de línea.
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

# --- Triage con IA (opcional; sin clave se escanea sin IA) ---
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
AI_EFFORT=medium
AI_MAX_REQUESTS_PR=15
AI_MAX_REQUESTS_FULL=60
# Caché del triage entre escaneos (en docker-compose ya apunta a un volumen).
AI_CACHE_DIR=

# --- Comportamiento ---
REPORT_LANGUAGE=es
FAIL_ON=high
MAX_REPO_MB=500

# --- Seguridad ---
# Cifrado en reposo (obligatorio en producción). Genera una clave con:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DATA_ENCRYPTION_KEY=
# Escaneo aislado en un subproceso sin secretos. SCAN_SANDBOX_CMD admite bubblewrap, etc. (ver docs/DESPLIEGUE.md).
SCAN_SANDBOX=subprocess
SCAN_SANDBOX_CMD=
# Contenedor efímero por escaneo (RF-4.4): plantilla con {src} {out} {files_from} {engines}. Si se define,
# cada escaneo corre en su propio contenedor (gVisor/Firecracker/K8s Job). Ver docs/DESPLIEGUE.md.
SCAN_RUNNER=
# Solo instalaciones propias con Jira/GitLab internos: permite conectar a IPs privadas (desactiva la defensa SSRF).
EGRESS_ALLOW_PRIVATE=
SCAN_TIMEOUT=900

# --- Red teaming dinámico de endpoints con LLM (RF-2.7) ---
REDTEAM_ENABLED=1
REDTEAM_TIMEOUT=30

# --- Demo sin GitHub: usuario «user» / contraseña «pass». Nunca con datos de clientes ---
DEMO_LOGIN=0
# Equipo de seguridad (logins de GitHub separados por comas): ven la vista Equipo de pentests.
STAFF_LOGINS=

# --- Login del panel con GitHub (OAuth de la GitHub App) ---
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
SESSION_SECRET=
PUBLIC_URL=http://localhost:8000

# --- Cobros con Stripe (ver docs/DESPLIEGUE.md, sección 3b) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_TEAM=
STRIPE_PRICE_BUSINESS=

# Acceso de emergencia a la API para operaciones (los clientes entran con GitHub).
ADMIN_API_TOKEN=
