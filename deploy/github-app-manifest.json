{
  "name": "appsec-ai",
  "url": "https://example.com",
  "description": "Seguridad de código y de aplicaciones con IA: SAST, secretos, dependencias, IaC y OWASP Top 10 para LLM, con triage y correcciones con IA.",
  "hook_attributes": {
    "url": "https://TU-DOMINIO/webhooks/github",
    "active": true
  },
  "redirect_url": "https://TU-DOMINIO/",
  "public": true,
  "default_permissions": {
    "contents": "write",
    "metadata": "read",
    "pull_requests": "write",
    "checks": "write",
    "members": "read"
  },
  "default_events": [
    "pull_request",
    "push",
    "check_run"
  ],
  "callback_urls": [
    "https://TU-DOMINIO/auth/callback"
  ],
  "request_oauth_on_install": false
}
